generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COBRANZAS
  TECNICO
  SUPERVISOR
}

enum CancellationStatus {
  SOLICITADA
  EN_REVISION
  PENDIENTE_DE_PAGO
  PAGADA
  EQUIPOS_RECUPERADOS
  BAJA_COMPLETADA
}

enum CancellationReason {
  FALLAS_CONTINUAS
  INCUMPLIMIENTO_CONTRATO
  MUDANZA
  PROBLEMAS_ATENCION
  MEJOR_OFERTA
  DECISION_VOLUNTARIA
}

enum EquipmentType {
  ONU
  ROUTER
  STB
  ANTENA
  OTRO
}

enum EquipmentCondition {
  BUENO
  DANADO
  NO_ENTREGADO
}

enum CollectionManagementType {
  LLAMADA
  WHATSAPP
  VISITA
  CORREO
  SMS
  OTRO
}

enum CollectionResult {
  CONTESTO
  NO_CONTESTO
  PROMESA_DE_PAGO
  PAGO
  CONVENIO
  SE_NIEGA_A_PAGAR
  CLIENTE_NO_UBICADO
}

enum CollectionChargeType {
  CONSUMO_MENSUAL
  CAMBIO_DOMICILIO
  EXCEDENTE_FIBRA
  INSTALACION
  STREAMS
  RECONEXION
  OTRO
}

enum ServiceTechnology {
  FIBRA
  RADIOENLACE
}

enum PlanChangeStatus {
  BORRADOR
  PENDIENTE_DE_FIRMA
  FIRMADO
  ACTIVO
  CANCELADO
  RECHAZADO
  ANULADO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(COBRANZAS)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  cancellations Cancellation[] @relation("CreatedBy")
  auditLogs     AuditLog[]
  collectionActionsRegistered CollectionAction[] @relation("CollectionRegisteredBy")
  collectionActionsAsAgent    CollectionAction[] @relation("CollectionAgent")
  collectionPayments CollectionPayment[]
  collectionCharges CollectionCharge[]
  assignedCustomers Customer[] @relation("AssignedCollectionAgent")
  technologyEvents CustomerTechnologyEvent[]
  planChangesCreated PlanChange[] @relation("PlanChangeCreatedBy")
  planChangesDiscountAuth PlanChange[] @relation("PlanChangeDiscountAuth")
  planChangesVoided PlanChange[] @relation("PlanChangeVoidedBy")
}

model Customer {
  id               String   @id @default(cuid())
  contract         String   @unique
  name             String
  cedula           String
  address          String
  zone             String   @default("CENTRO")
  phone            String?
  serviceStartDate DateTime
  planName         String
  status           String   @default("ACTIVO")
  hasTvStreaming   Boolean  @default(false)
  tvStreamingSince DateTime?
  pendingBalance   Decimal  @default(0) @db.Decimal(10, 2)
  overdueSince     DateTime?
  openTechnicalClaim Boolean @default(false)
  inCollectionWhitelist Boolean @default(false)
  assignedAgentUserId String?
  assignedAgentName   String?
  originTechnology    ServiceTechnology @default(FIBRA)
  currentTechnology   ServiceTechnology @default(FIBRA)
  fiberInstallDate    DateTime?
  fiberMigrationDate  DateTime?
  migrationReviewRequired Boolean @default(false)
  createdAt        DateTime @default(now())
  email            String?
  activeServicePlanId String?
  planMonthlyUsd    Decimal? @db.Decimal(10, 2)
  planSpeedMbps     Int?
  contractPermanenceStart DateTime?
  contractPermanenceEnd   DateTime?

  equipment     CustomerEquipment[]
  cancellations Cancellation[]
  collectionActions CollectionAction[]
  collectionPayments CollectionPayment[]
  collectionCharges CollectionCharge[]
  assignedAgent User? @relation("AssignedCollectionAgent", fields: [assignedAgentUserId], references: [id])
  technologyEvents CustomerTechnologyEvent[]
  planChanges       PlanChange[]
  activeServicePlan ServicePlan? @relation("CustomerActivePlan", fields: [activeServicePlanId], references: [id])
}

model CustomerEquipment {
  id         String        @id @default(cuid())
  customerId String
  type       EquipmentType
  serial     String?
  brand      String?
  model      String?

  customer          Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cancellationItems CancellationEquipment[]
}

model TariffConfig {
  id                      String  @id @default(cuid())
  permanenceMonths        Int     @default(18)
  installCostUsd          Decimal @default(200) @db.Decimal(10, 2)
  tvMonthlyUsd            Decimal @default(2) @db.Decimal(10, 2)
  addendumDeclarationText String?
}

model ServicePlan {
  id          String   @id @default(cuid())
  name        String
  speedMbps   Int
  monthlyUsd  Decimal  @db.Decimal(10, 2)
  installUsd  Decimal  @default(0) @db.Decimal(10, 2)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activeCustomers Customer[] @relation("CustomerActivePlan")
  planChangesFrom PlanChange[] @relation("PlanChangeFrom")
  planChangesTo   PlanChange[] @relation("PlanChangeTo")
}

model PlanChange {
  id                    String           @id @default(cuid())
  customerId            String
  addendumNumber        String?          @unique
  status                PlanChangeStatus @default(BORRADOR)
  requestDate           DateTime         @default(now())
  confirmedAt           DateTime?
  signedAt              DateTime?
  activatedAt           DateTime?
  cancelledAt           DateTime?
  voidedAt              DateTime?

  previousPlanName      String
  previousSpeedMbps     Int?
  previousMonthlyUsd    Decimal          @db.Decimal(10, 2)
  previousPermanenceStart DateTime?
  previousPermanenceEnd   DateTime?

  newPlanId             String?
  newPlanName           String
  newSpeedMbps          Int
  newMonthlyUsd         Decimal          @db.Decimal(10, 2)
  standardMonthlyUsd    Decimal          @db.Decimal(10, 2)
  discountReason        String?
  discountAuthorizedById String?
  discountAuthorizedAt  DateTime?

  newPermanenceStart    DateTime?
  newPermanenceEnd      DateTime?
  permanenceMonths      Int              @default(18)

  originalContractDate  DateTime
  clientSignatureName   String?
  clientSignatureCedula String?
  signatureImageData    String?
  signatureConsent      Boolean          @default(false)
  signatureIp           String?
  signedPdfData         String?

  voidReason            String?
  voidedById            String?
  notes                 String?

  createdById           String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  customer              Customer         @relation(fields: [customerId], references: [id])
  newPlan               ServicePlan?     @relation("PlanChangeTo", fields: [newPlanId], references: [id])
  previousPlan          ServicePlan?     @relation("PlanChangeFrom", fields: [previousPlanId], references: [id])
  previousPlanId        String?
  createdBy             User             @relation("PlanChangeCreatedBy", fields: [createdById], references: [id])
  discountAuthorizedBy  User?            @relation("PlanChangeDiscountAuth", fields: [discountAuthorizedById], references: [id])
  voidedBy              User?            @relation("PlanChangeVoidedBy", fields: [voidedById], references: [id])
}

model EquipmentTariff {
  id             String        @id @default(cuid())
  type           EquipmentType @unique
  damagedUsd     Decimal       @db.Decimal(10, 2)
  notReturnedUsd Decimal       @db.Decimal(10, 2)
}

model Cancellation {
  id               String             @id @default(cuid())
  customerId       String
  reason           CancellationReason   @default(DECISION_VOLUNTARIA)
  requestDate      DateTime           @default(now())
  closeDate        DateTime?
  monthsCompleted  Int                @default(0)
  permanenceAmount Decimal            @default(0) @db.Decimal(10, 2)
  tvAmount         Decimal            @default(0) @db.Decimal(10, 2)
  monthlyAmount    Decimal            @default(0) @db.Decimal(10, 2)
  equipmentAmount  Decimal            @default(0) @db.Decimal(10, 2)
  otherAmount      Decimal            @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal            @default(0) @db.Decimal(10, 2)
  invoiceNumber    String?
  status           CancellationStatus @default(SOLICITADA)
  notes            String?
  clientSignature  String?
  qrCode           String?            @unique
  actaNumber       String?            @unique
  actaPhysicalCode String?            @unique
  permanenceStartDate DateTime?
  originTechnology    ServiceTechnology?
  currentTechnology   ServiceTechnology?
  fiberInstallPending Boolean?
  withdrawalRequestFileName String?
  withdrawalRequestFileData String?
  withdrawalRequestUploadedAt DateTime?
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  customer  Customer                @relation(fields: [customerId], references: [id])
  createdBy User                    @relation("CreatedBy", fields: [createdById], references: [id])
  equipment CancellationEquipment[]
  charges   CancellationCharge[]
  payments  CancellationPayment[]
}

model CancellationEquipment {
  id             String              @id @default(cuid())
  cancellationId String
  equipmentId    String?
  type           EquipmentType
  serial         String?
  brand          String?
  model          String?
  delivered      Boolean             @default(false)
  condition      EquipmentCondition?
  chargeAmount   Decimal             @default(0) @db.Decimal(10, 2)
  notes          String?

  cancellation Cancellation       @relation(fields: [cancellationId], references: [id], onDelete: Cascade)
  equipment    CustomerEquipment? @relation(fields: [equipmentId], references: [id])
}

model CancellationCharge {
  id             String  @id @default(cuid())
  cancellationId String
  concept        String
  amount         Decimal @db.Decimal(10, 2)

  cancellation Cancellation @relation(fields: [cancellationId], references: [id], onDelete: Cascade)
}

model CancellationPayment {
  id             String   @id @default(cuid())
  cancellationId String
  paymentDate    DateTime
  method         String
  invoiceNumber  String
  amountPaid     Decimal  @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime @default(now())

  cancellation Cancellation @relation(fields: [cancellationId], references: [id], onDelete: Cascade)
}

model DocumentSequence {
  key   String @id
  value Int    @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model CollectionAction {
  id               String                   @id @default(cuid())
  customerId       String
  userId           String
  agentUserId      String
  agentName        String
  actionDate       DateTime                 @default(now())
  managementType   CollectionManagementType
  result           CollectionResult
  notes            String?
  nextFollowUpDate DateTime?
  promiseDate      DateTime?
  promiseAmount    Decimal?                 @db.Decimal(10, 2)
  promiseNotes     String?
  attachmentName   String?
  attachmentData   String?
  photoName        String?
  photoData        String?
  createdAt        DateTime                 @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation("CollectionRegisteredBy", fields: [userId], references: [id])
  agent    User     @relation("CollectionAgent", fields: [agentUserId], references: [id])
}

model CollectionPayment {
  id            String   @id @default(cuid())
  customerId    String
  userId        String
  paymentDate   DateTime
  amount        Decimal  @db.Decimal(10, 2)
  fenixDocument String
  paymentMethod String?
  notes         String?
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
}

model CollectionCharge {
  id          String               @id @default(cuid())
  customerId  String
  userId      String
  chargeType  CollectionChargeType
  description String?
  periodLabel String?
  periodFrom  DateTime?
  periodTo    DateTime?
  amount      Decimal              @db.Decimal(10, 2)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
}

model CustomerTechnologyEvent {
  id             String            @id @default(cuid())
  customerId     String
  userId         String
  eventType      String
  fromTechnology ServiceTechnology
  toTechnology   ServiceTechnology
  eventDate      DateTime
  notes          String?
  createdAt      DateTime          @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
}
